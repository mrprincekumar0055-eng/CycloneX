# CycloneX Environment Configuration
PROJECT_NAME="CycloneX"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="cyclonex-super-secret-production-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# If POSTGRES_SERVER is set, it will connect to PostgreSQL/PostGIS.
# Otherwise, transparent fallback to SQLite (with local spatial computations) is used.
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="cyclonex_user"
POSTGRES_PASSWORD="cyclonex_password"
POSTGRES_DB="cyclonex_db"
DATABASE_URL="sqlite:///./cyclonex.db"

# Redis & Workers
REDIS_URL="redis://localhost:6379/0"

# External API Configuration (with offline fallback capability)
NASA_GIBS_API_URL="https://gibs.earthdata.nasa.gov"
OPEN_METEO_API_URL="https://api.open-meteo.com/v1"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OSRM_API_URL="http://router.project-osrm.org"
WORLDPOP_API_URL="https://data.worldpop.org"

# Operational Mode
DEMO_MODE=true
ALLOW_SYNTHETIC_FALLBACK=true

