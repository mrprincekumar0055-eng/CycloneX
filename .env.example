# ==============================================================================
# CycloneX Production Environment Configuration Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Project Settings)
# ------------------------------------------------------------------------------
# Primary public HTTPS URL of the deployed FastAPI backend.
# In production, must be the public domain of your deployed backend service.
# Example: https://cyclonex-api.onrender.com or https://api.cyclonex.gov.in
NEXT_PUBLIC_API_BASE_URL="https://cyclonex-api.onrender.com"

# Server-side runtime proxy URL for Next.js SSR and rewrites
BACKEND_URL="https://cyclonex-api.onrender.com"


# ------------------------------------------------------------------------------
# 2. BACKEND CORE CONFIGURATION (Set in Render / Railway / Cloud Run / .env)
# ------------------------------------------------------------------------------
PROJECT_NAME="CycloneX"
VERSION="1.0.0"
ENVIRONMENT="production"            # 'production' or 'development'
PORT=8000                           # Injected automatically by cloud host (Render/Railway/Heroku)
HOST="0.0.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-tokens"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated list of origins permitted to call the API)
BACKEND_CORS_ORIGINS="https://cyclone-x-hro.vercel.app,https://cyclone-x.vercel.app,http://localhost:3000"


# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Production: Use managed PostgreSQL (e.g. Supabase, Neon, Render PostgreSQL, Railway)
# Example: postgresql://user:password@host.render.com:5432/cyclonex_db
DATABASE_URL="sqlite:///./cyclonex.db"


# ------------------------------------------------------------------------------
# 4. EXTERNAL METEOROLOGICAL & GEOSPATIAL DATA PROVIDERS
# ------------------------------------------------------------------------------
OPEN_METEO_API_URL="https://api.open-meteo.com/v1"
NASA_GIBS_API_URL="https://gibs.earthdata.nasa.gov"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OSRM_API_URL="http://router.project-osrm.org"
WORLDPOP_API_URL="https://data.worldpop.org"


# ------------------------------------------------------------------------------
# 5. OPERATIONAL & SIMULATION MODES
# ------------------------------------------------------------------------------
DEMO_MODE=true                      # Enables reference scenario anchors (Biparjoy)
ALLOW_SYNTHETIC_FALLBACK=true       # Graceful degradation if external providers timeout


# ------------------------------------------------------------------------------
# 6. EARLY WARNING ALERTS & NOTIFICATION DISPATCH
# ------------------------------------------------------------------------------
# Master switch: Keep false until live provider credentials have been verified
LIVE_ALERTS_ENABLED=false
NOTIFICATION_MAX_HOURLY_SMS=20
NOTIFICATION_MAX_HOURLY_EMAIL=50

# Authorized test recipients for controlled verification (cannot be arbitrary numbers)
TEST_NOTIFICATION_PHONE="+91-98765-43210"
TEST_NOTIFICATION_EMAIL="admin@cyclonex.gov.in"

# SMS Provider Configuration ('mock' | 'twilio' | 'generic_http')
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""

# Email Provider Configuration ('mock' | 'smtp' | 'sendgrid')
EMAIL_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="CycloneX Operations <alerts@cyclonex.gov.in>"
SMTP_USE_TLS=true
SENDGRID_API_KEY=""

# Automatic ML-to-Alert Evaluation Monitor
ALERT_MONITOR_ENABLED=true
ALERT_MONITOR_INTERVAL_SECONDS=900  # 15 minutes, aligns with weather poller
